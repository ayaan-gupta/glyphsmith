{
  "name": "glyphsmith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Ten hand-drawn letters in, a complete installable font in your handwriting out.",
  "scripts": {
    "dev": "vite --port 4102 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4102 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "font": "tsx scripts/make-font.ts",
    "art": "tsx scripts/build-art.ts",
    "validate": "tsx scripts/make-font.ts --out dist-font && .venv/bin/python scripts/validate_font.py dist-font/Glyphsmith-Demo.ttf dist-font/Glyphsmith-Demo.woff2",
    "demo": "tsx scripts/record-demo.ts"
  },
  "dependencies": {
    "brotli-wasm": "^3.0.1",
    "clipper-lib": "^6.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "gifenc": "^1.0.3",
    "opentype.js": "^1.3.4",
    "playwright": "^1.48.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
